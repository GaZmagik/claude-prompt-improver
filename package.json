{
  "name": "claude-prompt-improver",
  "version": "1.10.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/GaZmagik/claude-prompt-improver"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.1.0",
    "typescript": "^5.7.0"
  },
  "description": "Claude Code plugin that automatically improves prompts based on classification and context",
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": ["claude", "claude-code", "plugin", "prompt-engineering", "prompt-improvement"],
  "license": "MIT",
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "type": "module"
}
